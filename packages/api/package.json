{
  "name": "@postgrify/api",
  "version": "0.2.0",
  "description": "Postgrify REST API — multi-database PostgreSQL gateway",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/websocket": "^8.3.1",
    "@node-rs/argon2": "^2.0.2",
    "@scalar/fastify-api-reference": "^1.25.0",
    "@types/nodemailer": "^8.0.1",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^6.0.0",
    "jose": "^5.2.0",
    "lru-cache": "^10.2.0",
    "node-cron": "^4.6.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.3",
    "redis": "^4.6.13",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^1.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
