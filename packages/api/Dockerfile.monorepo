# ─── Build aşaması ────────────────────────────────────────────────────────────
# Context: monorepo root (package-lock.json ve node_modules buradadir)
FROM node:20-alpine AS builder

# node-pty native addon derlemesi için gerekli araçlar
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Root bağımlılık dosyaları — monorepo lock dosyası
COPY package.json package-lock.json ./

# API package.json (workspace bağımlılıkları için)
COPY packages/api/package.json ./packages/api/

# npm ci: lock dosyasından deterministik, hızlı yükleme
RUN npm ci --workspace=packages/api

# API kaynak ve config
COPY packages/api/tsconfig.json ./packages/api/
COPY packages/api/src ./packages/api/src

WORKDIR /app/packages/api

RUN npm run build

# ─── Production aşaması ───────────────────────────────────────────────────────
FROM node:20-alpine AS runner

# Runtime araçlar
RUN apk update
RUN apk add --no-cache bash libstdc++ curl jq wget
# postgresql-client: paket adı Alpine versiyonuna göre değişir
RUN apk add --no-cache postgresql-client 2>/dev/null || \
    apk add --no-cache postgresql16-client 2>/dev/null || \
    apk add --no-cache postgresql17-client 2>/dev/null || \
    echo "WARNING: postgresql-client not installed"

ENV SHELL=/bin/bash

WORKDIR /app

RUN addgroup -g 1001 -S postgrify && \
    adduser -S postgrify -u 1001

# Root + API package.json — production bağımlılıkları için
COPY package.json ./
COPY packages/api/package.json ./packages/api/

# node_modules ve dist builder'dan kopyala — node-pty native binary zaten derlenmiş
# Monorepo: node_modules root'ta, dist packages/api/dist'ta
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=builder /app/packages/api/dist ./packages/api/dist

USER postgrify

WORKDIR /app/packages/api

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "dist/index.js"]