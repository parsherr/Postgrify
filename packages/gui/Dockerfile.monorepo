# ─── Build aşaması: local dist kullanır ──────────────────────────────────────
# Context: monorepo root
# Kullanım:
#   cd packages/gui && npm run build   (local build — dist/ üretir)
#   cd .. && docker compose up -d gui --build
#
# Neden pre-built: npm ci --workspace inside Docker kurduğu
# node_modules farkından dolayı farklı bundle hash üretiyor.
# Local build deterministik, hızlı ve CI'da tekrarlanabilir.
FROM node:20-alpine AS builder

WORKDIR /app

# Pre-built dist kopyala
COPY packages/gui/dist ./packages/gui/dist

# ─── Production: nginx ile static serve ───────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/packages/gui/dist /usr/share/nginx/html
COPY packages/gui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]