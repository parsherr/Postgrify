 # =============================================================================
  # Postgrify — Environment Variables Example
  # Kullanım: cp packages/.env.example packages/.env
# =============================================================================

  # PostgreSQL
 # Docker + yerel PG için: PG_HOST=172.19.0.1
 # Docker içi container için: PG_HOST=postgres
 # Local dev için: PG_HOST=localhost
  PG_HOST=172.19.0.1
  PG_PORT=5432
  PG_USER=postgres
  PG_PASSWORD=your-pg-password-here
  PG_SSL=false

  # Connection Pool
  PG_MAX_POOL_SIZE=10
  PG_POOL_IDLE_TIMEOUT=30000
  PG_POOL_MAX_LIFETIME=3600000

  # Auth (openssl rand -hex 32)
  JWT_SECRET=replace-with-min-32-char-secret-use-openssl-rand-hex-32
  ADMIN_SECRET=replace-with-min-16-char-admin-secret
  JWT_EXPIRY=24h

  # Admin GUI girişi
  # ADMIN_EMAIL ve ADMIN_PASSWORD_HASH ayarlanmazsa GUI login devre dışı kalır.
  # Hash üretmek için: cd packages/api && npx tsx scripts/hash-password.ts "şifreniz"
  ADMIN_EMAIL=admin@postgrify.local
  ADMIN_PASSWORD_HASH=replace-with-argon2id-hash-from-hash-password-script
  ACCESS_TOKEN_EXPIRY=15m
  REFRESH_TOKEN_EXPIRY=7d

  # Rate Limiting
  RATE_LIMIT_GLOBAL=1000
  RATE_LIMIT_DB=500
  RATE_LIMIT_ADMIN=200

  # Redis (opsiyonel)
  # REDIS_URL=redis://localhost:6379

  # Sunucu
  PORT=3000
  NODE_ENV=development
  LOG_LEVEL=info
  CORS_ORIGINS=http://localhost:5173

  # Özellik Bayrakları
  ALLOW_RAW_SQL_ADMIN=true
  QUERY_LOG_ENABLED=false
  SLOW_QUERY_THRESHOLD_MS=500

  # Docker Compose postgres container
  POSTGRES_USER=postgres
  POSTGRES_PASSWORD=mayhem
  POSTGRES_DB=postgres

  # GUI — Vite build-time
  VITE_API_URL=http://localhost:3000