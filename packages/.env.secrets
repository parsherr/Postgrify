# Bu dosya Docker Compose'un env_file interpolation sorununu çözer.
# argon2 hash içindeki $ karakterleri burada güvenli saklanır.
# env_file yerine secrets dosyasına taşındı.
#
# Güncelleme: npx tsx packages/api/scripts/hash-password.ts "yeni-sifre"
# Çıktıyı ADMIN_PASSWORD_HASH= satırına yapıştır.
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$x6GWQgBkGnPjBPlNYxfn+g$cyHdYctixJW/olyFQdvFAI9UEXwm1AAu9jghzhyLUds