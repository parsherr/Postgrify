# Root monorepo .dockerignore
# Context: monorepo root — sadece GUI build için kullanılır

# Kesinlikle dışla — dev bağımlılıkları
node_modules
packages/api/node_modules
packages/gui/node_modules

# Build çıktıları
packages/api/dist
# packages/gui/dist intentionally NOT excluded — Dockerfile.monorepo uses pre-built dist

# Git
.git
.gitignore

# Env dosyaları (hassas)
.env
.env.*
!.env.example
packages/.env
packages/.env.*
!packages/.env.example

# Editor
.vscode
.idea
*.swp

# Logs
*.log
npm-debug.log*

# Test çıktıları
coverage